# LLM Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Document Parsing API (Optional, local PyPDF fallback included)
DOC_PARSER_API_KEY=your_doc_parser_key_here

# Embeddings API (Voyage AI or Gemini text-embedding-004)
VOYAGE_API_KEY=your_voyage_api_key_here
EMBEDDINGS_API_KEY=your_embeddings_api_key_here
EMBEDDINGS_MODEL=voyage-context-3

# Web Search API (Tavily or Firecrawl)
WEB_SEARCH_API_KEY=your_web_search_api_key_here

# Conversation Memory Backend (Zep Cloud or local fallback)
MEMORY_API_KEY=your_memory_api_key_here
ZEP_API_URL=https://api.getzep.com
